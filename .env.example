# Optional URL checked by the /health route. It must return a successful HTTP response.
HEALTHCHECK_URL=https://api.github.com/zen

# Copy this file to .env.local and replace the placeholder with your key.
# Server-only AI configuration. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
